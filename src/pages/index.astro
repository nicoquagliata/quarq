---
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="theme-color" content="#1d1d1b" />
    <meta name="description" content="QUARQ. Próximamente." />

    <title>QUARQ</title>

    <link rel="icon" type="image/png" href="/favicon.png" />
	<link rel="apple-touch-icon" href="/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <main>

		<img
  class="background-image"
  src="/quarq_background.webp"
  alt=""
  aria-hidden="true"
/>

<div class="background-overlay" aria-hidden="true"></div>

      <img
        class="brand-image"
        src="/quarq-logo.png"
        alt=""
        aria-hidden="true"
      />

      <img
        class="symbol-image"
        src="/quarq-symbol.png"
        alt=""
        aria-hidden="true"
      />

      <header class="topline">
  <a class="header-brand" href="/" aria-label="QUARQ — Inicio">
    <img src="/quarq-logo.webp" alt="QUARQ" />
  </a>

  <span>Próximamente</span>
</header>

      <section class="hero" aria-labelledby="brand-title">
        <h1 id="brand-title" class="visually-hidden">QUARQ</h1>
      </section>

      <footer class="contact" aria-label="Datos de contacto">
        <a
          href="tel:+59892990635"
          aria-label="Llamar al 092 990 635"
        >
          092 990 635
        </a>

        <a href="mailto:info@quarq.uy">
          info@quarq.uy
        </a>

        <a
          href="https://www.instagram.com/quarq.uy/"
          target="_blank"
          rel="noreferrer"
        >
          Instagram · @quarq.uy
        </a>
      </footer>
    </main>
	
  </body>
</html>